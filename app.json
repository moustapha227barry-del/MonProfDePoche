{
  "expo": {
    "name": "Mon Prof de Poche",
    "slug": "mon-prof-de-poche",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monprofdepoche",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "primaryColor": "#8B5CF6",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "app.monprofdepoche",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#08080F"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080F",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mon Prof de Poche utilise le microphone pour enregistrer vos cours.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ]
  }
}
